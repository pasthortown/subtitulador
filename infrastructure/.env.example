# ==============================================
# Subtitulador - Variables de Entorno
# ==============================================
# Copiar este archivo a .env y ajustar según necesidad
# Uso: docker-compose up -d

# ----------------------------------------------
# BACKEND - Servicio de Transcripción
# ----------------------------------------------

# Puerto expuesto del backend
BACKEND_PORT=8000

# Modelo de Whisper a usar
# Opciones: tiny, base, small, medium, large, large-v2, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Dispositivo de procesamiento
# Opciones: cuda (GPU NVIDIA), cpu
WHISPER_DEVICE=cuda

# Tipo de cómputo para GPU
# Opciones: float16, float32, int8
WHISPER_COMPUTE_TYPE=float16

# Idioma por defecto para transcripción
# Códigos ISO 639-1: es, en, pt, fr, de, it, ja, ko, zh, ru
DEFAULT_LANGUAGE=es

# Nivel de logging
# Opciones: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Número de workers del servidor
WORKERS=2

# ----------------------------------------------
# TRANSLATION - Servicio de Traducción
# ----------------------------------------------

# Puerto expuesto de LibreTranslate
TRANSLATION_PORT=5001

# Idiomas a cargar (separados por coma)
# Esto reduce el uso de memoria cargando solo los idiomas necesarios
LT_LOAD_ONLY=es,en,pt

# Número de hilos para traducción
LT_THREADS=4

# Límite de caracteres por solicitud
LT_CHAR_LIMIT=5000

# Deshabilitar interfaz web de LibreTranslate
LT_DISABLE_WEB_UI=false
